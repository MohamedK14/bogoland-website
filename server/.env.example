# Copy this file to .env and fill in real values. Never commit .env itself.

# Neon connection string — from your Neon project dashboard ("Connection string").
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Cloudinary — from your Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login — single hardcoded admin account.
# ADMIN_PASSWORD_HASH is generated by running: npm run hash-password
# (never put the plain password itself in this file)
ADMIN_EMAIL=admin@bogoland.com
ADMIN_PASSWORD_HASH=

# Any long random string, used to sign admin login tokens.
JWT_SECRET=

# Comma-separated list of origins allowed to call this API.
# Include your GitHub Pages URL and whatever you use to preview locally — note
# that http://localhost:5500 and http://127.0.0.1:5500 are DIFFERENT origins
# to a browser, so include both if you're not sure which one you'll open.
ALLOWED_ORIGINS=https://mohamedk14.github.io,http://localhost:5500,http://127.0.0.1:5500

# Port the server listens on (Render/Railway set this automatically in production).
PORT=3000
